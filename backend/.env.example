# ── AstroGuard Backend — Environment Variables ──────────────────────
# Copy to .env and fill in REAL values locally.
# Never commit .env to source control.

# Server
PORT=5000
NODE_ENV=development
# Set "production" on Render.

# MongoDB (required — must start with mongodb:// or mongodb+srv://)
MONGODB_URI=mongodb://localhost:27017/astroguard

# JWT signing secrets (REQUIRED in production — use long random strings)
JWT_SECRET=change_me_access_token_secret
REFRESH_TOKEN_SECRET=change_me_refresh_token_secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Frontend origin(s) allowed by CORS — comma separated.
# MUST include the real deployed frontend URL in production, e.g.:
# FRONTEND_URL=https://your-app.vercel.app
# Local defaults keep http://localhost:3000 working automatically.
FRONTEND_URL=http://localhost:3000

# Python ML service (optional)
ML_SERVICE_URL=http://localhost:8000

# AI service (optional)
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-5-mini

# Cloudinary (optional — required for profile-image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# Cookie notes: production cookies are emitted with SameSite=None; Secure
# automatically because the frontend (Vercel) and backend (Render) are
# cross-site. Do not set NODE_ENV=production unless both secrets are provided.